---
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: string;
}
const { title, description, path = '/', ogType = 'website' } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL('/og-image.png', SITE.url).href;

// WebSite + og:site_name are what make Google print the brand as the site name
// in a search result. Without them it falls back to showing the bare domain.
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.brand,
  alternateName: SITE.brandAlt,
  url: SITE.url,
  publisher: { '@type': SITE.schemaType, name: SITE.brand, url: SITE.url }
};

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': SITE.schemaType,
  name: SITE.brand,
  url: SITE.url,
  telephone: SITE.phone,
  description: SITE.metaDescription,
  areaServed: SITE.areaServed,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.state,
    addressCountry: 'US'
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: SITE.opens,
    closes: SITE.closes
  },
  priceRange: '$$'
};

const navLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/#areas', label: 'Coverage' },
  { href: '/blog/', label: 'Guides' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#121417" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Overpass:wght@700;800;900&family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label={`${SITE.brand} home`}>
          <span class="brand-mark" aria-hidden="true" set:html={SITE.brandMarkSvg} />
          <span class="brand-name">{SITE.brandLead} <span>{SITE.brandTail}</span></span>
        </a>

        <nav class="nav-desktop" aria-label="Main">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>

        <a class="header-call" href={`tel:${SITE.phone}`}>
          <span class="hc-status" aria-hidden="true"></span>
          <span class="hc-nums">
            <span class="hc-num">{SITE.phoneDisplay}</span>
            <span class="hc-digits">{SITE.phoneDigits}</span>
          </span>
        </a>

        <!-- Mobile menu: native <details> so it needs no JavaScript and still
             reports expanded/collapsed state to screen readers. -->
        <details class="nav-mobile">
          <summary aria-label="Toggle navigation menu">
            <svg class="icon-open" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </summary>
          <nav class="nav-mobile-panel" aria-label="Mobile">
            {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            <a class="nav-mobile-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
          </nav>
        </details>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="foot-inner">
        <div class="foot-lead">
          <p class="foot-brand">{SITE.brandLead} <span>{SITE.brandTail}</span></p>
          <p class="foot-tag">{SITE.tagline}</p>
          <a class="foot-call" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          <p class="foot-digits">{SITE.phoneDigits}</p>
          <p class="foot-hours"><span class="dot" aria-hidden="true"></span>{SITE.hoursLine}</p>
        </div>
        <div class="foot-cols">
          <div>
            <p class="foot-h">Coverage</p>
            {SITE.footerAreas.map((a) => <a href={`/areas/${a.slug}/`}>{a.name}</a>)}
          </div>
          <div>
            <p class="foot-h">Service area</p>
            <p class="foot-meta">{SITE.zips.join('  ·  ')}</p>
          </div>
        </div>
      </div>
      <div class="foot-base">
        <p>{SITE.legalLine}</p>
        <p>© {new Date().getFullYear()} {SITE.brand} · {SITE.city}, {SITE.state}</p>
      </div>
    </footer>

    <a class="callbar" href={`tel:${SITE.phone}`} aria-label={`Call ${SITE.brand} at ${SITE.phoneDigits}`}>
      <span class="callbar-status" aria-hidden="true"></span>
      <span class="callbar-text">
        <span class="callbar-label">{SITE.callBarLabel}</span>
        <span class="callbar-num">{SITE.phoneDisplay}</span>
      </span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
    </a>
    <!-- Line fitting. The build joins the words around each sentence break
         with no-break spaces (scripts/typeset.mjs). That keeps sentences off
         line edges, but on a narrow screen it can leave short lines mid-
         paragraph. For each paragraph this tries the joined and unjoined text
         at a few near-invisible letter-spacing steps, and keeps whichever reads
         best at the reader's actual width: a sentence near a line edge costs
         3, a stub last line 2, a lone last word 4, a short inner line 1. -->
    <script is:inline>
      (function () {
        var STEPS = [0, -0.006, 0.006, -0.012, 0.012, -0.018, 0.018, -0.024, 0.024, -0.03, 0.03];
        var END = /[.?!]["')\u201d]?$/;
        var NB = /\u00a0/g;
        var saved = new WeakMap();
        function lines(el) {
          var out = [], walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), n, m, re;
          while ((n = walker.nextNode())) {
            re = /[^\s\u00a0]+/g;
            while ((m = re.exec(n.data))) {
              var r = document.createRange();
              r.setStart(n, m.index); r.setEnd(n, m.index + m[0].length);
              var rc = r.getClientRects();
              if (!rc.length) continue;
              var top = Math.round(rc[0].top), last = out[out.length - 1];
              var w = { w: m[0], l: rc[0].left, r: rc[rc.length - 1].right };
              if (last && Math.abs(last.top - top) < 6) last.ws.push(w); else out.push({ top: top, ws: [w] });
            }
          }
          return out;
        }
        function score(el) {
          var L = lines(el);
          if (L.length < 2) return 0;
          var cs = getComputedStyle(el);
          var box = el.getBoundingClientRect().width - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
          var s = 0, width = 0;
          L.forEach(function (l) { width = Math.max(width, l.ws[l.ws.length - 1].r - l.ws[0].l); });
          var lastL = L[L.length - 1], lw = lastL.ws[lastL.ws.length - 1].r - lastL.ws[0].l;
          if (lastL.ws.length === 1) s += 4;
          else if (lw < width * 0.3) s += 2;
          L.forEach(function (l, i) {
            var ws = l.ws, k;
            if (i > 0) for (k = 0; k < Math.min(2, ws.length - 1); k++) if (END.test(ws[k].w)) s += 3;
            if (i < L.length - 1) {
              for (k = Math.max(1, ws.length - 2); k < ws.length; k++) if (END.test(ws[k - 1].w)) s += 3;
              if (L.length > 2 && ws[ws.length - 1].r - ws[0].l < box * 0.62) s += 1;
            }
          });
          return s;
        }
        // Joined (as built) or unjoined text. Unjoining keeps the paragraph's
        // final no-break space, which holds the last two words together.
        function textNodes(el) {
          var out = [], w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), n;
          while ((n = w.nextNode())) out.push(n);
          return out;
        }
        function setJoined(el, on) {
          var nodes = textNodes(el), lastNode = null, i;
          for (i = nodes.length - 1; i >= 0; i--) if (nodes[i].data.indexOf('\u00a0') > -1) { lastNode = nodes[i]; break; }
          nodes.forEach(function (n) {
            if (!saved.has(n)) saved.set(n, n.data);
            var orig = saved.get(n);
            if (on) { n.data = orig; return; }
            if (n === lastNode) {
              var cut = orig.lastIndexOf('\u00a0');
              n.data = orig.slice(0, cut).replace(NB, ' ') + orig.slice(cut);
            } else n.data = orig.replace(NB, ' ');
          });
          el.querySelectorAll('.nw').forEach(function (x) { x.style.whiteSpace = on ? '' : 'normal'; });
        }
        function fit() {
          var els = document.querySelectorAll('main p, main li, main .sent, .foot-base p');
          for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (!el.getClientRects().length || el.querySelector('.sent')) continue;
            var joins = el.textContent.indexOf('\u00a0') > -1 ? [true, false] : [true];
            var best = Infinity, bestJ = true, bestStep = 0;
            for (var a = 0; a < joins.length && best > 0; a++) {
              setJoined(el, joins[a]);
              for (var j = 0; j < STEPS.length && best > 0; j++) {
                el.style.letterSpacing = STEPS[j] ? STEPS[j] + 'em' : '';
                var s = score(el) + (joins[a] ? 0 : 0.5);
                if (s < best) { best = s; bestJ = joins[a]; bestStep = STEPS[j]; }
              }
            }
            setJoined(el, bestJ);
            el.style.letterSpacing = bestStep ? bestStep + 'em' : '';
          }
        }
        var t, lastW = window.innerWidth;
        (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(fit);
        window.addEventListener('resize', function () {
          if (window.innerWidth === lastW) return;
          lastW = window.innerWidth;
          clearTimeout(t); t = setTimeout(fit, 150);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Valley night: asphalt graphite base, tule-fog paper sections, one road-flare
     accent, and interstate-sign green for labels. Signage type (Overpass is
     drawn from Highway Gothic) and tight sign-plate corners. */
  :root {
    --ink: #121417;
    --ink-2: #181b1f;
    --ink-panel: #1f2328;
    --ivory: #eceeea;
    --paper-line: #d3d7d0;
    --accent: #ff6b2c;
    --accent-2: #ffa070;      /* lighter end of accent gradients */
    --accent-deep: #ad3e09;   /* accent text on fog paper */
    --accent-soft: rgba(255, 107, 44, 0.14);
    --accent-ink: #1a0800;
    --sign: #17673f;          /* interstate guide-sign green */
    --sign-deep: #0f4f2f;
    --slate: #a6aca5;
    --slate-deep: #5b6159;
    --ink-line: rgba(255, 255, 255, 0.08);
    --ink-line-2: rgba(255, 255, 255, 0.16);
    --display: 'Overpass', 'Arial Narrow', system-ui, sans-serif;
    --sans: 'Public Sans', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;

    /* Tight sign-plate corners and flat, solid panels: this reads as road
       equipment, not a soft consumer app. */
    --r: 8px;
    --r-sm: 5px;
    --shadow-lg: 0 22px 44px -22px rgba(0, 0, 0, 0.7), 0 2px 6px -2px rgba(0, 0, 0, 0.45);
    --shadow-sm: 0 8px 20px -12px rgba(0, 0, 0, 0.55);
    /* A cool haze at the top of dark sections: tule fog under a sodium lamp. */
    --glow: radial-gradient(90% 55% at 50% 0%, rgba(214, 222, 212, 0.075) 0%, transparent 72%);
  }
  * { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  body {
    background: var(--ink); color: var(--ivory); font-family: var(--sans);
    font-size: 1.0625rem; line-height: 1.65;
    padding-bottom: 84px;
  }
  @media (min-width: 900px) { body { padding-bottom: 0; } }
  a { color: var(--accent); text-decoration: none; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
  img, svg { max-width: 100%; }

  h1, h2, h3 { font-family: var(--display); font-weight: 800; line-height: 1.04; letter-spacing: -0.015em; text-wrap: balance; }
  h1 { font-size: clamp(2.5rem, 5.6vw, 4.4rem); font-weight: 900; }
  h2 { font-size: clamp(1.85rem, 3.8vw, 2.75rem); }
  h3 { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.005em; }
  p, li, figcaption, dd { text-wrap: pretty; }
  p + p { margin-top: 1em; }
  .sent { display: block; }
  .nw { white-space: nowrap; }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem); }
  section { position: relative; padding: clamp(4rem, 9vw, 7rem) 0; }

  .s-ink { background: var(--ink); }
  .s-ink::before, .s-ink-2::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 60%;
    background: var(--glow); pointer-events: none;
  }
  .s-ink-2 { background: var(--ink-2); border-block: 1px solid var(--ink-line); }
  .s-ink > .wrap, .s-ink-2 > .wrap { position: relative; }
  .s-paper { background: var(--ivory); color: var(--ink); }
  .s-paper h1, .s-paper h2, .s-paper h3 { color: var(--ink); }
  .s-paper a { color: var(--accent-deep); }
  .s-paper .muted { color: var(--slate-deep); }

  /* Eyebrow as a guide-sign plate: green field, inset white border. */
  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--display); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.07em; font-size: 0.74rem; line-height: 1; color: #fff;
    padding: 0.55rem 0.8rem 0.45rem; margin-bottom: 1.4rem; white-space: nowrap;
    background: var(--sign); border-radius: var(--r-sm);
    box-shadow: inset 0 0 0 2px var(--sign), inset 0 0 0 3.5px rgba(255,255,255,0.9);
  }

  /* Hero emphasis: solid flare color, no gradient. */
  .grad { color: var(--accent); }
  .muted { color: var(--slate); }
  .lead { font-size: clamp(1.1rem, 1.6vw, 1.25rem); line-height: 1.6; max-width: 34em; }
  .prose { max-width: 46em; }
  .prose h2 { font-size: clamp(1.55rem, 3vw, 2.1rem); margin-top: 2.6rem; }
  .prose > h2:first-child, .prose > :first-child > h2:first-child { margin-top: 0; }
  .prose p { margin-top: 0.9rem; }

  .btn-call {
    display: inline-flex; align-items: center; gap: 0.65rem;
    background: var(--accent); color: var(--accent-ink);
    font-family: var(--display); font-weight: 800; font-size: 1.15rem; letter-spacing: 0.01em;
    padding: 0.95rem 1.5rem 0.8rem; white-space: nowrap;
    border-radius: var(--r-sm); margin-top: 1.7rem; box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .s-paper .btn-call { color: var(--accent-ink); }
  .btn-call:hover { transform: translateY(-2px); background: #ff7d45; box-shadow: 0 14px 28px -12px rgba(255,107,44,0.6); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;
    color: inherit; margin-top: 1.7rem; margin-left: 1.1rem;
    border-bottom: 2px solid var(--accent); padding-bottom: 2px;
  }

  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: rgba(18, 20, 23, 0.88);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--ink-line);
  }
  /* A strip of reflective chevron tape along the header's bottom edge. */
  .site-header::after {
    content: ''; position: absolute; inset: auto 0 -3px; height: 3px;
    background: repeating-linear-gradient(135deg, var(--accent) 0 9px, transparent 9px 18px);
    opacity: 0.85;
  }
  .header-inner {
    position: relative; max-width: 1180px; margin: 0 auto;
    padding: 0.75rem clamp(1rem, 4vw, 3rem);
    display: flex; align-items: center; gap: 1.6rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--ivory); }
  .brand-mark {
    display: grid; place-items: center; width: 38px; height: 38px;
    color: var(--accent-ink); background: var(--accent); border-radius: 7px; flex: none;
  }
  .brand-name { font-family: var(--display); font-weight: 900; font-size: 1.22rem; letter-spacing: -0.01em; white-space: nowrap; padding-top: 3px; }
  .brand-name span { color: var(--accent); }

  .nav-desktop { display: flex; gap: 1.5rem; margin-left: auto; }
  .nav-desktop a { color: var(--slate); font-weight: 600; font-size: 0.95rem; transition: color 0.15s; }
  .nav-desktop a:hover { color: var(--ivory); }

  .header-call {
    display: flex; align-items: center; gap: 0.6rem; color: var(--ivory);
    padding: 0.4rem 0.85rem; border: 1px solid var(--ink-line-2);
    border-radius: var(--r-sm); transition: border-color 0.15s;
  }
  .header-call:hover { border-color: var(--accent); }
  .hc-nums { display: flex; flex-direction: column; line-height: 1.1; }
  .hc-num { font-family: var(--mono); font-weight: 700; font-size: 1rem; white-space: nowrap; }
  .hc-digits { font-family: var(--mono); font-size: 0.66rem; color: var(--slate); white-space: nowrap; }
  .hc-status {
    width: 8px; height: 8px; border-radius: 50%; background: #56d364; flex: none;
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(86,211,100,0.45); }
    70% { box-shadow: 0 0 0 7px rgba(86,211,100,0); }
    100% { box-shadow: 0 0 0 0 rgba(86,211,100,0); }
  }

  /* Mobile hamburger */
  .nav-mobile { display: none; }
  .nav-mobile summary {
    list-style: none; display: grid; place-items: center;
    width: 44px; height: 44px; border: 1px solid var(--ink-line-2);
    border-radius: var(--r-sm); color: var(--ivory); cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile .icon-close { display: none; }
  .nav-mobile[open] .icon-open { display: none; }
  .nav-mobile[open] .icon-close { display: block; }
  .nav-mobile-panel {
    position: absolute; top: calc(100% + 3px); left: 0; right: 0;
    display: flex; flex-direction: column;
    background: var(--ink-2); border-bottom: 1px solid var(--ink-line);
    box-shadow: var(--shadow-lg); padding: 0.4rem clamp(1rem, 4vw, 3rem) 1rem;
  }
  .nav-mobile-panel a {
    color: var(--ivory); font-family: var(--display); font-weight: 800; font-size: 1.2rem;
    padding: 0.9rem 0.2rem 0.75rem; border-bottom: 1px solid var(--ink-line);
  }
  .nav-mobile-call {
    margin-top: 0.5rem; color: var(--accent) !important;
    font-family: var(--mono) !important; font-size: 1rem !important;
    border-bottom: none !important;
  }
  @media (max-width: 860px) {
    .nav-desktop { display: none; }
    .header-call { margin-left: auto; }
    .nav-mobile { display: block; }
  }
  @media (max-width: 560px) {
    .header-call { display: none; }
    .nav-mobile { margin-left: auto; }
  }

  .grid { display: grid; gap: 1.1rem; }
  @media (min-width: 640px) { .grid.c2 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 640px) and (max-width: 979px) { .grid.c3, .grid.c4 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) {
    .grid.c3 { grid-template-columns: repeat(3, 1fr); }
    .grid.c4 { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 980px) {
    .grid.bento { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; }
    .grid.bento > :first-child { grid-column: span 2; }
  }

  /* Solid panels. On hover a strip of hazard chevron lights along the top. */
  .card {
    position: relative; display: block; padding: 1.7rem 1.5rem 1.5rem;
    background: var(--ink-panel);
    border: 1px solid var(--ink-line); border-radius: var(--r);
    color: var(--ivory); overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card::after {
    content: ''; position: absolute; inset: 0 0 auto; height: 4px;
